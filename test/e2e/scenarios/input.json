{
  "cols": 100,
  "rows": 32,
  "theme": "dark",
  "mode": "autocode",
  "fake": "./input.fake.json",
  "project": "../fixtures/project",
  "steps": [
    { "waitFor": "/help for commands", "timeoutMs": 30000 },
    { "type": "explain @cli" },
    { "waitFor": "src/cli.ts", "timeoutMs": 10000 },
    { "waitIdle": 300 },
    { "snapshot": "mention-menu" },
    { "key": "tab" },
    { "waitIdle": 300 },
    { "snapshot": "mention-completed" },
    { "paste": "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8" },
    { "waitIdle": 300 },
    { "snapshot": "paste-placeholder" },
    { "key": "enter" },
    { "waitFor": "TURN_END", "timeoutMs": 30000 },
    { "waitIdle": 400 },
    { "snapshot": "after-turn" },
    { "type": "first line\\" },
    { "key": "enter" },
    { "type": "second line" },
    { "waitIdle": 300 },
    { "snapshot": "multiline" },
    { "key": "enter" },
    { "waitFor": "/Second turn done/", "timeoutMs": 30000 },
    { "waitIdle": 400 },
    { "snapshot": "after-second-turn" }
  ]
}
